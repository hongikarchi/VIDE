// Email-free staging: owner-approved membership, uploads and PC snapshots paused to preserve the
// free-only budget. Snapshots stay off (0 MB) until an approved decision accepts R2 charges.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vide-sharing-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vide-sharing-staging",
      "database_id": "c7f1541a-6fd5-43fb-b70f-6247af392a2e",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "https://vide-sharing-staging.archivibe.workers.dev",
    "EMAIL_FROM": "",
    "AUTH_MODE": "manual-approval",
    "UPLOADS_ENABLED": "false",
    "SNAPSHOTS_ENABLED": "false",
    "SNAPSHOT_TOTAL_MB": "0"
  },
  // Shared notes (ADR-034): one SQLite-backed Durable Object per note (the free plan's only DO kind).
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "NoteRoom" }]
  },
  "migrations": [{ "tag": "v1-notes", "new_sqlite_classes": ["NoteRoom"] }],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "vide-sharing-staging",
      "remote": false
    }
  ],
  "assets": {
    "directory": "../../dist/sharing",
    "binding": "WEB",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "account_id": "04342c5d7e3c1adaf6da81a8964b3ed4",
  "preview_urls": false
}
