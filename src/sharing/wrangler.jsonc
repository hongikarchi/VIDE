{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vide-sharing-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vide-sharing-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": false
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "http://127.0.0.1:8792",
    "EMAIL_FROM": "VIDE <noreply@example.com>"
  }
}
