{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vide-sharing-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vide-sharing-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": false
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "http://127.0.0.1:8792",
    "EMAIL_FROM": "VIDE <noreply@example.com>"
  },
  // Shared notes (ADR-034): one SQLite-backed Durable Object per note (the free plan's only DO kind).
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "NoteRoom" }]
  },
  "migrations": [{ "tag": "v1-notes", "new_sqlite_classes": ["NoteRoom"] }],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "vide-sharing-local",
      "remote": false
    }
  ],
  "assets": {
    "directory": "../../dist/sharing",
    "binding": "WEB",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
