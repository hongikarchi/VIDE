{
  "layout": "jig-run",
  "left": [
    {
      "part": "site-picker",
      "input": "inputs.site"
    },
    {
      "part": "step-rail"
    },
    {
      "part": "param-group"
    },
    {
      "part": "bake-card",
      "title": "Rhino에 만들기",
      "bake": [
        "targets",
        "outline",
        "parcels",
        "roads",
        "buildings",
        "terrain",
        "contours",
        "siteInfo"
      ]
    }
  ],
  "center": {
    "views": [
      {
        "part": "plan-map",
        "title": "평면",
        "layers": [
          {
            "key": "parcels",
            "title": "주변 필지",
            "from": "step.frame.parcels",
            "shape": "polygon",
            "label": "lot",
            "tone": "ov-grid"
          },
          {
            "key": "roads",
            "title": "접한 도로",
            "from": "step.roads.roads",
            "shape": "polygon",
            "label": "lot",
            "tone": "ov-existing",
            "dashed": true
          },
          {
            "key": "buildings",
            "title": "건물",
            "from": "step.buildings.buildings",
            "shape": "polygon",
            "tone": "ov-existing",
            "fill": true
          },
          {
            "key": "targets",
            "title": "대상 필지",
            "from": "step.frame.targets",
            "shape": "polygon",
            "label": "lot",
            "tone": "ov-new",
            "fill": true
          }
        ]
      },
      {
        "part": "report",
        "report": "site-summary"
      }
    ],
    "kpis": {
      "part": "kpi-strip",
      "items": [
        {
          "label": "대지면적(공부)",
          "from": "step.summary.officialArea_m2",
          "unit": "m²",
          "decimals": 1,
          "empty": "공부 면적 없음"
        },
        {
          "label": "대지면적(계산)",
          "from": "step.summary.computedArea_m2",
          "unit": "m²",
          "decimals": 1
        },
        {
          "label": "주변 건물",
          "from": "step.summary.buildings",
          "unit": "동"
        },
        {
          "label": "최고 높이",
          "from": "step.summary.maxHeight_m",
          "unit": "m",
          "decimals": 1
        },
        {
          "label": "확인 필요",
          "from": "step.summary.checks",
          "unit": "건",
          "warnAbove": 0
        }
      ]
    }
  },
  "drawer": {
    "part": "result-tabs",
    "tabs": [
      {
        "title": "대지 요약",
        "part": "table",
        "from": "step.summary.rows",
        "columns": [
          {
            "field": "item",
            "label": "항목"
          },
          {
            "field": "value",
            "label": "값"
          },
          {
            "field": "basis",
            "label": "출처 구분"
          },
          {
            "field": "source",
            "label": "자료"
          },
          {
            "field": "at",
            "label": "조회 시각"
          }
        ],
        "csv": "대지요약"
      },
      {
        "title": "수집 상태",
        "part": "issue-table",
        "from": "step.collect.sources",
        "columns": [
          {
            "field": "name",
            "label": "자료"
          },
          {
            "field": "text",
            "label": "상태"
          },
          {
            "field": "count",
            "label": "개수"
          },
          {
            "field": "checks",
            "label": "확인 필요"
          },
          {
            "field": "fetchedAt",
            "label": "조회 시각"
          }
        ]
      },
      {
        "title": "대상 필지",
        "part": "table",
        "from": "step.frame.targets",
        "overlay": "targets",
        "columns": [
          {
            "field": "lot",
            "label": "지번"
          },
          {
            "field": "pnu",
            "label": "PNU"
          },
          {
            "field": "landCategory",
            "label": "지목"
          },
          {
            "field": "officialArea",
            "label": "공부 면적",
            "unit": "m²",
            "decimals": 2
          },
          {
            "field": "computedArea",
            "label": "계산 면적",
            "unit": "m²",
            "decimals": 2
          },
          {
            "field": "source",
            "label": "자료"
          }
        ]
      },
      {
        "title": "도로",
        "part": "table",
        "from": "step.roads.roads",
        "overlay": "roads",
        "columns": [
          {
            "field": "direction",
            "label": "방향"
          },
          {
            "field": "lot",
            "label": "지번"
          },
          {
            "field": "widthMin_m",
            "label": "계산 폭(최소)",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "widthAvg_m",
            "label": "계산 폭(평균)",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "contact_m",
            "label": "접도 길이",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "widthSource",
            "label": "계산 출처"
          }
        ],
        "csv": "도로"
      },
      {
        "title": "건물",
        "part": "schedule",
        "from": "step.buildings.buildings",
        "overlay": "buildings",
        "columns": [
          {
            "field": "name",
            "label": "건물"
          },
          {
            "field": "floors",
            "label": "층수"
          },
          {
            "field": "height",
            "label": "높이",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "heightSource",
            "label": "높이 출처"
          },
          {
            "field": "use",
            "label": "주용도"
          },
          {
            "field": "ground",
            "label": "바닥 높이",
            "unit": "m",
            "decimals": 2
          }
        ],
        "csv": "주변건물"
      },
      {
        "title": "만들지 않음",
        "part": "issue-table",
        "from": "step.buildings.unmade",
        "columns": [
          {
            "field": "name",
            "label": "건물"
          },
          {
            "field": "reason",
            "label": "이유"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "id": "report",
      "label": "보고서 보기",
      "report": "site-summary",
      "tier": "T1"
    }
  ]
}
