  "steps": [
    {
      "id": "site",
      "title": "대지 입력",
      "kind": "library",
      "use": "vide/massing-kit#siteStep",
      "reads": [
        "input.site.boundary",
        "input.site.roads",
        "input.site.neighbors",
        "param.segmentTolerance",
        "param.northBasis",
        "param.gridNorthDeg",
        "param.convergenceDeg"
      ],
      "writes": "site",
      "speed": "live",
      "gates": [
        {
          "use": "inputs-present"
        },
        {
          "use": "stale-input"
        },
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "regulations",
      "title": "규제 조건",
      "kind": "library",
      "use": "vide/massing-kit#regulationStep",
      "reads": [
        "param.coverageState",
        "param.coverage",
        "param.heightMaxState",
        "param.heightMax",
        "param.streetHeightState",
        "param.streetHeight",
        "param.altitudeHeightState",
        "param.altitudeHeight",
        "param.floorsMaxState",
        "param.floorsMax",
        "param.roadSetbackState",
        "param.roadSetback",
        "param.chamferLengthState",
        "param.chamferLength",
        "param.openSpaceRoadState",
        "param.openSpaceRoad",
        "param.openSpaceAdjacentState",
        "param.openSpaceAdjacent",
        "param.civilSetbackState",
        "param.civilSetback",
        "param.otherSetbackState",
        "param.otherSetback",
        "param.sunState",
        "param.sunBaseHeight",
        "param.sunNearDistance",
        "param.sunRatio",
        "param.sunDatumRoad",
        "param.sunDistance",
        "param.farBaseState",
        "param.farBase",
        "param.farAllowedState",
        "param.farAllowed",
        "param.farMaxState",
        "param.farMax",
        "param.incentiveState",
        "param.incentiveFar",
        "param.incentiveHeight",
        "param.openSpaceIncentiveState",
        "param.openSpaceIncentiveFar",
        "param.publicOpenSpaceState",
        "param.publicOpenSpace",
        "param.landscapeRatioState",
        "param.landscapeRatio",
        "param.parkingState",
        "param.parkingRounding",
        "param.parkingRoundScope",
        "param.parkingAreaBasis",
        "param.parkingEntryState",
        "param.parkingEntryCornerDistance",
        "input.legal"
      ],
      "writes": "regulations",
      "speed": "live",
      "gates": [
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "plan",
      "title": "계획 조건",
      "kind": "library",
      "use": "vide/massing-kit#planStep",
      "reads": [
        "param.mainUse",
        "param.floorHeightGround",
        "param.floorHeightTypical",
        "param.basementFloors",
        "param.targetFar",
        "param.studyHeight",
        "param.northBasis",
        "param.basementFloorHeight",
        "param.basementSetback"
      ],
      "writes": "plan",
      "speed": "live",
      "gates": [
        {
          "use": "basis-required",
          "level": "warn"
        },
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "limits",
      "title": "제한선",
      "kind": "library",
      "use": "vide/massing-kit#limitStep",
      "needs": ["site", "regulations"],
      "reads": [
        "step.site",
        "step.regulations",
        "input.site.limitLines",
        "input.site.otherLines",
        "input.site.sunDatum",
        "input.site.sunZone"
      ],
      "writes": "limits",
      "speed": "live",
      "gates": [
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "buildable",
      "title": "가능 영역",
      "kind": "library",
      "use": "vide/massing-kit#buildableStep",
      "needs": ["limits"],
      "reads": ["step.site", "step.regulations", "step.limits"],
      "writes": "buildable",
      "speed": "live",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 30000
      }
    },
    {
      "id": "envelope",
      "title": "3D 가능 외피",
      "kind": "library",
      "use": "vide/massing-kit#envelopeStep",
      "needs": ["buildable", "plan"],
      "reads": ["step.site", "step.regulations", "step.plan", "step.limits"],
      "writes": "envelope",
      "speed": "release",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 60000
      }
    },
    {
      "id": "floors",
      "title": "층 나누기",
      "kind": "library",
      "use": "vide/massing-kit#floorsStep",
      "needs": ["envelope", "plan"],
      "reads": ["step.site", "step.plan", "step.envelope"],
      "writes": "floors",
      "speed": "release",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 60000
      }
    },
    {
      "id": "openSpace",
      "title": "공개공지",
      "kind": "library",
      "use": "vide/massing-kit#openSpaceStep",
      "needs": ["site", "regulations"],
      "reads": [
        "step.site",
        "step.regulations",
        "input.site.openSpaceZones",
        "param.openSpaceCandidate"
      ],
      "writes": "openSpace",
      "speed": "release",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 30000
      }
    },
    {
      "id": "alternatives",
      "title": "대안",
      "kind": "library",
      "use": "vide/massing-kit#alternativesStep",
      "needs": ["floors", "openSpace"],
      "reads": [
        "step.site",
        "step.regulations",
        "step.envelope",
        "step.floors",
        "step.openSpace",
        "param.trimMethod",
        "param.humanBase"
      ],
      "writes": "alternatives",
      "speed": "release",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 120000
      }
    },
    {
      "id": "confirmChoice",
      "title": "고른 대안 확정",
      "kind": "human",
      "slot": "confirm-inputs",
      "needs": ["alternatives"],
      "reads": ["step.alternatives", "param.chosenAlternative"],
      "writes": "confirmChoice",
      "speed": "confirm",
      "blocks": ["chosen"]
    },
    {
      "id": "chosen",
      "title": "고른 대안",
      "kind": "library",
      "use": "vide/massing-kit#chosenStep",
      "needs": ["confirmChoice", "alternatives"],
      "reads": ["step.alternatives", "param.chosenAlternative"],
      "writes": "chosen",
      "speed": "live",
      "gates": [
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "useDraft",
      "title": "용도 배분 AI 초안",
      "kind": "ai",
      "prompt": "prompts/use-draft.md",
      "authority": "draft-only",
      "needs": ["alternatives"],
      "reads": ["step.alternatives", "step.plan", "step.regulations"],
      "writes": "useDraft",
      "speed": "button",
      "gates": [
        {
          "use": "numbers-in-source"
        },
        {
          "use": "no-plan-dependent-conclusion"
        }
      ]
    },
    {
      "id": "acceptUseDraft",
      "title": "AI 초안 받기",
      "kind": "human",
      "slot": "confirm-inputs",
      "needs": ["useDraft"],
      "reads": ["step.useDraft"],
      "writes": "acceptUseDraft",
      "speed": "confirm",
      "blocks": ["useDraftApplied"]
    },
    {
      "id": "useDraftApplied",
      "title": "받은 초안을 용도 표에 넣기",
      "kind": "library",
      "use": "vide/massing-kit#applyUseDraft",
      "needs": ["acceptUseDraft", "alternatives"],
      "reads": ["step.useDraft", "step.alternatives"],
      "writes": "useDraftApplied",
      "speed": "button",
      "gates": [
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "useMix",
      "title": "용도 배분",
      "kind": "library",
      "use": "vide/massing-kit#useMixStep",
      "needs": ["alternatives"],
      "reads": ["step.alternatives", "step.plan", "step.regulations"],
      "writes": "useMix",
      "speed": "release",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 30000
      }
    },
    {
      "id": "parking",
      "title": "주차·조경",
      "kind": "library",
      "use": "vide/massing-kit#parkingStep",
      "needs": ["useMix", "floors", "openSpace"],
      "reads": [
        "step.site",
        "step.regulations",
        "step.plan",
        "step.useMix",
        "step.alternatives",
        "step.floors",
        "step.openSpace",
        "input.site.landscapeZones",
        "input.site.parkingExclusions",
        "param.plannedParking",
        "param.parkingAreaGround",
        "param.parkingAreaUnder",
        "param.parkingAreaMech",
        "param.parkingAlternative"
      ],
      "writes": "parking",
      "speed": "release",
      "gates": [
        {
          "use": "no-nan"
        }
      ],
      "budget": {
        "wallClockMs": 60000
      }
    },
    {
      "id": "handoff",
      "title": "넘겨줄 결과(고른 대안)",
      "kind": "library",
      "use": "vide/massing-kit#handoffStep",
      "needs": ["chosen", "parking"],
      "reads": [
        "step.chosen",
        "step.site",
        "step.regulations",
        "step.plan",
        "step.envelope",
        "step.useMix",
        "step.parking"
      ],
      "writes": "handoff",
      "speed": "live",
      "gates": [
        {
          "use": "no-nan"
        }
      ]
    },
    {
      "id": "make",
      "title": "Rhino에 만들기",
      "kind": "host",
      "bake": ["limitLines", "envelopes"],
      "needs": ["envelope"],
      "reads": ["step.buildable", "step.envelope"],
      "writes": "made",
      "speed": "button"
    },
    {
      "id": "makeMass",
      "title": "대안 매스·주차·공지 Rhino에 만들기",
      "kind": "host",
      "bake": ["alternativeMasses", "groundZones", "parkingMasses"],
      "needs": ["parking"],
      "reads": ["step.useMix", "step.parking"],
      "writes": "madeMass",
      "speed": "button"
    }
  ],
  "outputs": [
    {
      "key": "chosen",
      "from": "step.handoff",
      "schema": "schemas/outputs/chosen.json"
    }
  ],
  "bake": [
    {
      "id": "limitLines",
      "template": "vide.bake.curves@1",
      "host": "rhino",
      "items": "step.buildable.lines",
      "layer": "제한선",
      "key": "key",
      "attrs": {
        "vide-rules": "rule"
      },
      "mode": "replace-own"
    },
    {
      "id": "envelopes",
      "template": "vide.bake.brep-faces@1",
      "host": "rhino",
      "items": "step.envelope.items",
      "layer": "외피",
      "key": "key",
      "attrs": {
        "vide-envelope": "kind",
        "vide-rules": "rules",
        "vide-volume-m3": "volumeText",
        "vide-unconfirmed": "unconfirmed"
      },
      "mode": "replace-own"
    },
    {
      "id": "alternativeMasses",
      "template": "vide.bake.extrude-polygon@1",
      "host": "rhino",
      "items": "step.useMix.items",
      "layer": "대안 매스",
      "key": "key",
      "attrs": {
        "vide-option": "option",
        "vide-floor": "floor",
        "vide-area-m2": "areaText",
        "vide-use": "use",
        "vide-unconfirmed": "unconfirmed"
      },
      "mode": "replace-own"
    },
    {
      "id": "groundZones",
      "template": "vide.bake.curves@1",
      "host": "rhino",
      "items": "step.parking.lines",
      "layer": "주차·공지",
      "key": "key",
      "attrs": {
        "vide-ground": "kind",
        "vide-area-m2": "areaText"
      },
      "mode": "replace-own"
    },
    {
      "id": "parkingMasses",
      "template": "vide.bake.extrude-polygon@1",
      "host": "rhino",
      "items": "step.parking.masses",
      "layer": "주차 추정",
      "key": "key",
      "attrs": {
        "vide-option": "option",
        "vide-floor": "floor",
        "vide-area-m2": "areaText",
        "vide-use": "use"
      },
      "mode": "replace-own"
    }
  ],
