<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetExt>.rhp</TargetExt>
    <RhinoSystem Condition="'$(RhinoSystem)' == ''">C:\Program Files\Rhino 8\System</RhinoSystem>
    <OutputPath>../../../.vide/build/rhino-worker/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Eto"><HintPath>$(RhinoSystem)\Eto.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystem)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <!-- Rhino 8 Python 3 for direct mode (ADR-029). -->
    <Reference Include="Rhino.Runtime.Code"><HintPath>$(RhinoSystem)\Rhino.Runtime.Code.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(RhinoSystem)\Microsoft.CodeAnalysis.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(RhinoSystem)\Microsoft.CodeAnalysis.CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- The host panel page helpers, shared with the ZWCAD palette (Design SCR-12). -->
  <ItemGroup>
    <Compile Include="..\..\common\PanelPage.cs" Link="PanelPage.cs" />
    <Compile Include="..\..\common\DiagnosticLog.cs" Link="DiagnosticLog.cs" />
  </ItemGroup>
</Project>
