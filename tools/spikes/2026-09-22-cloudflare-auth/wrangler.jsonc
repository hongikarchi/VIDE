{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vide-auth-local-spike",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vide-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": false
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "http://127.0.0.1:8791",
    "SPIKE_LOCAL": "1"
  }
}
