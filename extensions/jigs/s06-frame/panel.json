{
  "layout": "jig-run",
  "left": [
    {
      "part": "step-rail"
    },
    {
      "part": "role-card",
      "input": "inputs.site"
    },
    {
      "part": "param-group",
      "title": "배치",
      "group": "배치"
    },
    {
      "part": "param-group",
      "title": "거더 보정",
      "group": "거더 보정"
    },
    {
      "part": "param-group",
      "title": "작은보",
      "group": "작은보"
    },
    {
      "part": "param-group",
      "title": "하중",
      "group": "하중"
    },
    {
      "part": "param-group",
      "title": "해석",
      "group": "해석"
    },
    {
      "part": "param-group",
      "title": "기초",
      "group": "기초"
    },
    {
      "part": "param-group",
      "title": "기둥",
      "group": "기둥"
    },
    {
      "part": "param-group",
      "title": "진단",
      "group": "진단"
    },
    {
      "part": "bake-card",
      "title": "Rhino에 만들기",
      "bake": ["lines", "members", "member-columns"]
    }
  ],
  "center": {
    "views": [
      {
        "part": "viewport-overlay",
        "title": "3D",
        "layers": [
          {
            "key": "existing",
            "title": "기존 기초",
            "from": "step.diagnose.shapes.existing",
            "shape": "polygon",
            "at": "points",
            "tone": "ov-existing"
          },
          {
            "key": "girders",
            "title": "보정한 거더",
            "from": "step.girders.girders",
            "shape": "line",
            "at": "points",
            "id": "id",
            "label": "id",
            "tone": "ov-new"
          },
          {
            "key": "dangling",
            "title": "기둥 없는 거더 끝",
            "from": "step.girders.danglingAt",
            "shape": "point",
            "at": "at",
            "id": "girderId",
            "label": "girderId",
            "tone": "warn"
          },
          {
            "key": "crossings",
            "title": "경계·보이드를 넘는 곳",
            "from": "step.girders.crossings",
            "shape": "point",
            "at": "at",
            "id": "girderId",
            "tone": "warn"
          },
          {
            "key": "beams",
            "title": "작은보",
            "from": "step.beams.beams",
            "shape": "line",
            "at": "points",
            "id": "id",
            "tone": "ov-grid"
          },
          {
            "key": "cantilevers",
            "title": "내민 보",
            "from": "step.beams.edgeCantilevers",
            "shape": "line",
            "at": "points",
            "id": "id",
            "tone": "ov-grid",
            "dashed": true
          },
          {
            "key": "axes",
            "title": "새 축선 · 제안",
            "from": "step.axes.axes",
            "shape": "line",
            "at": "line",
            "label": "name",
            "tone": "ov-grid",
            "dashed": true
          },
          {
            "key": "spans",
            "title": "거더망(경간) · 제안",
            "from": "step.axes.spans",
            "shape": "line",
            "at": "line",
            "tone": "ov-new",
            "colorBy": "length",
            "bands": "step.axes.bands.span"
          },
          {
            "key": "columns",
            "title": "기둥 · 제안",
            "from": "step.columns.columns",
            "shape": "line",
            "at": "line",
            "label": "mark",
            "tone": "ov-new"
          },
          {
            "key": "caps",
            "title": "파일캡 · 제안",
            "from": "step.footprints.caps",
            "shape": "polygon",
            "at": "points",
            "tone": "ov-new"
          },
          {
            "key": "cap-clash",
            "title": "파일캡 간섭 · 제안",
            "from": "step.interference.fills.capClash",
            "shape": "polygon",
            "at": "points",
            "id": "key",
            "label": "label",
            "tone": "ov-clash",
            "fill": true
          },
          {
            "key": "basin-clash",
            "title": "유수지 보 간섭 · 제안",
            "from": "step.interference.fills.basinClash",
            "shape": "polygon",
            "at": "points",
            "id": "key",
            "label": "label",
            "tone": "warn",
            "fill": true
          }
        ],
        "legend": {
          "part": "verdict-legend",
          "title": "경간 (m) · 대각 포함",
          "from": "step.axes.spans",
          "field": "length",
          "bands": "step.axes.bands.span",
          "overlay": "spans"
        }
      },
      {
        "part": "plan-map",
        "title": "평면",
        "rotate": "step.axes.frame.angleDeg",
        "layers": [
          {
            "key": "existing",
            "from": "step.diagnose.shapes.existing",
            "shape": "polygon",
            "at": "points",
            "tone": "ov-existing"
          },
          {
            "key": "cells",
            "from": "step.cells.cells",
            "shape": "polygon",
            "at": "polygon",
            "id": "id",
            "label": "id",
            "tone": "ov-grid"
          },
          {
            "key": "girders",
            "from": "step.girders.girders",
            "shape": "line",
            "at": "points",
            "id": "id",
            "label": "id",
            "tone": "ov-new"
          },
          {
            "key": "beams",
            "from": "step.beams.beams",
            "shape": "line",
            "at": "points",
            "id": "id",
            "tone": "ov-grid"
          },
          {
            "key": "dangling",
            "from": "step.girders.danglingAt",
            "shape": "point",
            "at": "at",
            "id": "girderId",
            "tone": "warn"
          },
          {
            "key": "axes",
            "from": "step.axes.axes",
            "shape": "line",
            "at": "line",
            "label": "name",
            "tone": "ov-grid",
            "dashed": true
          },
          {
            "key": "spans",
            "from": "step.axes.spans",
            "shape": "line",
            "at": "line",
            "tone": "ov-new",
            "colorBy": "length",
            "bands": "step.axes.bands.span"
          },
          {
            "key": "caps",
            "from": "step.footprints.caps",
            "shape": "polygon",
            "at": "points",
            "tone": "ov-new"
          },
          {
            "key": "columns",
            "from": "step.columns.columns",
            "shape": "point",
            "at": "at",
            "label": "mark",
            "tone": "ov-new"
          },
          {
            "key": "cap-clash",
            "from": "step.interference.fills.capClash",
            "shape": "polygon",
            "at": "points",
            "id": "key",
            "tone": "ov-clash",
            "fill": true
          }
        ]
      }
    ],
    "board": {
      "part": "slider-board",
      "title": "놓으면 다시 계산",
      "params": [
        "$snapTol_m",
        "$beamSpacing_m",
        "$planterD",
        "$deckL",
        "$spanMax",
        "$cantileverMax"
      ]
    },
    "kpis": {
      "part": "kpi-strip",
      "items": [
        {
          "label": "거더",
          "from": "step.girders.summary.girders",
          "unit": "개",
          "empty": "읽기 전"
        },
        {
          "label": "강재",
          "from": "step.schedule.totals.t",
          "unit": "t",
          "decimals": 1,
          "note": "예비 단면 · 물량용",
          "empty": "단면 선정 전"
        },
        {
          "label": "기둥 없는 끝",
          "from": "step.girders.summary.dangling",
          "unit": "곳",
          "warnAbove": 0,
          "empty": "읽기 전"
        },
        {
          "label": "경간 초과",
          "from": "step.girders.summary.spansOver",
          "unit": "개",
          "warnAbove": 0,
          "note": "평면 길이",
          "empty": "읽기 전"
        },
        {
          "label": "작은보",
          "from": "step.beams.summary.beams",
          "unit": "개",
          "empty": "칸 계산 전"
        },
        {
          "label": "최대 검정비",
          "from": "step.analysis.summary.maxRatio",
          "decimals": 2,
          "warnAbove": 1,
          "note": "미확정 미리보기",
          "empty": "해석 전"
        }
      ]
    }
  },
  "drawer": {
    "part": "result-tabs",
    "tabs": [
      {
        "title": "거더 보정 목록",
        "part": "issue-table",
        "from": "step.girders.girders",
        "key": "id",
        "overlay": "girders",
        "columns": [
          {
            "field": "id",
            "label": "거더"
          },
          {
            "field": "name",
            "label": "이름"
          },
          {
            "field": "kind",
            "label": "모양"
          },
          {
            "field": "note",
            "label": "보정"
          },
          {
            "field": "planLength_m",
            "label": "평면 길이",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "length_m",
            "label": "길이",
            "unit": "m",
            "decimals": 2
          }
        ],
        "csv": "거더보정"
      },
      {
        "title": "칸·작은보",
        "part": "table",
        "from": "step.beams.beams",
        "key": "id",
        "overlay": "beams",
        "columns": [
          {
            "field": "id",
            "label": "작은보"
          },
          {
            "field": "cellId",
            "label": "칸"
          },
          {
            "field": "from.girderId",
            "label": "시작 거더"
          },
          {
            "field": "to.girderId",
            "label": "끝 거더"
          },
          {
            "field": "length_m",
            "label": "길이",
            "unit": "m",
            "decimals": 2
          }
        ],
        "csv": "작은보"
      },
      {
        "title": "해석 요약",
        "part": "issue-table",
        "from": "step.analysis.rows",
        "key": "key",
        "columns": [
          {
            "field": "key",
            "label": "부재"
          },
          {
            "field": "judgement",
            "label": "판정(미확정 미리보기)"
          },
          {
            "field": "ratio",
            "label": "검정비",
            "decimals": 2
          },
          {
            "field": "clause",
            "label": "지배 조항"
          }
        ],
        "csv": "해석요약"
      },
      {
        "title": "참고 처짐",
        "part": "table",
        "from": "step.analysis.deflections",
        "key": "key",
        "columns": [
          {
            "field": "key",
            "label": "부재"
          },
          {
            "field": "deflection_mm",
            "label": "참고 처짐",
            "unit": "mm",
            "decimals": 1
          },
          {
            "field": "limit_mm",
            "label": "한계",
            "unit": "mm",
            "decimals": 1
          },
          {
            "field": "ratio",
            "label": "비",
            "decimals": 2
          }
        ],
        "csv": "참고처짐"
      },
      {
        "title": "단면",
        "part": "table",
        "from": "step.sizing.groups",
        "key": "id",
        "columns": [
          {
            "field": "roleLabel",
            "label": "역할"
          },
          {
            "field": "band",
            "label": "경간 띠"
          },
          {
            "field": "sectionName",
            "label": "단면"
          },
          {
            "field": "maxRatio",
            "label": "최대 검정비(미리보기)",
            "decimals": 2
          },
          {
            "field": "judgement",
            "label": "판정"
          },
          {
            "field": "beyondLimit",
            "label": "상한 밖 후보"
          }
        ],
        "csv": "단면선정"
      },
      {
        "title": "일람표",
        "part": "schedule",
        "from": "step.schedule.rows",
        "key": "mark",
        "columns": [
          {
            "field": "mark",
            "label": "부호"
          },
          {
            "field": "roleLabel",
            "label": "역할"
          },
          {
            "field": "section",
            "label": "단면"
          },
          {
            "field": "count",
            "label": "개수",
            "unit": "개"
          },
          {
            "field": "totalLength_m",
            "label": "총길이",
            "unit": "m",
            "decimals": 1
          },
          {
            "field": "kgpm",
            "label": "단위중량",
            "unit": "kg/m",
            "decimals": 1
          },
          {
            "field": "t",
            "label": "중량",
            "unit": "t",
            "decimals": 2
          },
          {
            "field": "maxRatio",
            "label": "최대 검정비",
            "decimals": 2
          }
        ],
        "csv": "부재일람표"
      },
      {
        "title": "높이",
        "part": "table",
        "from": "step.heights.rows",
        "key": "columnId",
        "columns": [
          {
            "field": "sourceId",
            "label": "기둥"
          },
          {
            "field": "drawnLength_m",
            "label": "그린 길이",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "length_m",
            "label": "강재 길이",
            "unit": "m",
            "decimals": 1
          },
          {
            "field": "gap_m",
            "label": "받침 높이",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "depth_mm",
            "label": "거더 춤",
            "unit": "mm",
            "decimals": 0
          },
          {
            "field": "levelDiff_m",
            "label": "레벨 차",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "judgement",
            "label": "판정"
          }
        ],
        "csv": "기둥높이"
      },
      {
        "title": "만들기",
        "part": "table",
        "from": "step.bakePlan.members",
        "key": "key",
        "columns": [
          {
            "field": "memberId",
            "label": "부재"
          },
          {
            "field": "mark",
            "label": "부호"
          },
          {
            "field": "sectionName",
            "label": "단면"
          },
          {
            "field": "length_m",
            "label": "길이",
            "unit": "m",
            "decimals": 2
          },
          {
            "field": "kgpm",
            "label": "단위중량",
            "unit": "kg/m",
            "decimals": 1
          }
        ],
        "csv": "만들기계획"
      }
    ]
  },
  "actions": [
    {
      "id": "recompute",
      "label": "다시 계산",
      "step": "analysis",
      "tier": "T1"
    },
    {
      "id": "confirm-analysis",
      "label": "해석 확정",
      "step": "confirmAnalysis",
      "tier": "T2"
    }
  ]
}
