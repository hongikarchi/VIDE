{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/server",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/server/**/*",
    "src/core/**/*",
    "src/ai/**/*",
    "src/contracts/**/*",
    "src/knowledge/**/*",
    "src/services/**/*",
    "hosts/**/*.ts",
    "extensions/**/*.ts",
    "src/jigs/runtime/child-entry.ts",
    "src/jigs/official/site-data/**/*",
    "src/jigs/official/compliance-kit/**/*"
  ]
}
