# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Claude Code local settings (machine-specific)
.claude/settings.local.json
# Agent worktrees created by Claude Code sessions
.claude/worktrees/

# private visual references (site / legal data) — keep out of the repo
docs/assets/reference/*.html

# build / dependencies (later)
node_modules/
dist/
build/
bin/
obj/
*.log

# Local product data and credentials
.vide/
.env
.env.*
!.env.example
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.controller
*.sqlite.controller-journal
# Managed CLI account profiles (may hold subscription logins) when a workspace DB sits in the repo root
cli-profiles/

# Local cloud tooling, credentials and diagnostics
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
*.db
*.db-wal
*.db-shm
*.sqlite-journal
*.dmp
*.pfx
*.p12
*.key
*.pem
# User CAD documents belong in product data, not source control.
*.3dm
*.3dmbak
*.dwg
*.dwl
*.dwl2
# Deliberately reviewed synthetic test fixtures may be committed.
!tests/fixtures/**/*.3dm
!tests/fixtures/**/*.dwg

# Rust build output (structure core, PLAN-17)
src/native/**/target/
# Cargo binary sources (src/bin/*.rs, [[bin]] in Cargo.toml) are code, not build output.
!src/native/**/src/bin/
