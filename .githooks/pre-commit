#!/bin/sh
# Check that the Markdown documents still build before every commit (AI.md §4).
# The HTML itself is generated into human/ (git-ignored) and is never committed.
# Activate once per clone:  git config core.hooksPath .githooks
#   (tools/docs `npm install` runs this for you via postinstall)
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d tools/docs/node_modules ]; then
  echo "[docs] tools/docs/node_modules 가 없습니다. 먼저:  npm --prefix tools/docs install" >&2
  exit 1
fi
# Renders every document in memory (writes nothing) and fails on broken links or front matter.
node tools/docs/build.mjs --check --quiet || { echo "[docs] 문서 검사 실패 — 위 항목을 MD에서 고친 뒤 다시 커밋하세요." >&2; exit 1; }
node tools/checks/commit.mjs || exit 1
exit 0
